    // THIS HULL's own parameters, measured from the offsets above by
    // `vela-cli form` at the floating waterline. They are not the YD-41's
    // published values, and they must not be confused with them: this block
    // says what this mesh is, so that a later edit to the offsets that is not
    // reflected here shows up as a percentage. How close the mesh comes to the
    // published YD-41 is a separate question, asserted in
    // crates/vela-core/tests/yd41_form_study.rs.
    //
    // Cp and Cm read about 1-2 % away from the analytic fit in the header, and
    // the reason is discretization rather than error: with 17 stations the beam
    // and area peaks fall between stations, so the measured maxima are slightly
    // low, and Cp = V/(Am Lwl) rises to compensate. Volume, LCB, LCF and Lwl —
    // all integrals or ratios of integrals — agree to a fraction of a percent.
    parameters: (
        waterline_length: 11.9000,
        waterline_beam: 3.1284,
        canoe_draft: 0.4034,
        canoe_volume: 6.0629,
        wetted_surface: 28.3918,
        waterplane_area: 26.5699,
        prismatic: 0.5707,
        midship: 0.7075,
        lcb_percent: -4.1861,
        lcf_percent: -7.1106,
    ),

    // Appendages and rig are copied verbatim from boats/yd41.ron, where their
    // provenance is documented in full: Appendix 1 and Fig 5.19 for the keel and
    // rudder, Fig 12.15 for the rig, with every estimated value flagged there.
    //
    // They belong on this hull because this hull *is* the YD-41 — fitted to its
    // published coefficients rather than lofted from an offset table the book
    // never printed. A keel and rig from the same yacht are the only ones that
    // make sense on it.
    //
    // What differs from yd41.ron, and does so deliberately: displacement is
    // 6221 kg here against 5900 kg there. The fitted hull carries slightly more
    // volume than the published particulars, and the mass follows the geometry
    // so that the boat floats at the draft its own offsets describe. Sail and
    // appendage forces do not depend on displacement; resistance and stability
    // do, so the two files are not interchangeable and neither is a copy of the
    // other.
    appendages: (
        keel:   (root_chord: 1.00, tip_chord: 0.78, span: 1.90, sweep_deg: 5.5),
        rudder: (root_chord: 0.48, tip_chord: 0.22, span: 1.15, sweep_deg: 10.0),
        keel_volume: 0.275,
        keel_cb_height: 1.4013,
    ),

    rig: (
        foretriangle_height: 16.20,
        foretriangle_base: 5.10,
        main_hoist: 16.70,
        main_foot: 5.60,
        jib_perpendicular: 5.40,
        spinnaker_leech: 16.25,
        boom_above_sheer: 1.70,
        mast_above_sheer: 18.60,
        mast_diameter: 0.16,
        average_freeboard: 1.28,
        max_beam: 4.20,
    ),

    // Longitudinal layout, derived rather than measured: see boats/yd41.ron.
    layout: (
        keel_at: 5.95,
        rudder_at: 0.85,
        mast_at: 6.301,
    ),
    mass: (
        displacement_kg: 6221.0,
        cog: (x: 5.4509, y: 0.0, z: 0.2),
        gyradii: (rx: 1.25, ry: 2.90, rz: 2.95),
    ),
)
